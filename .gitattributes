# force LF everywhere. index.js has a #! line and is executable, and a CRLF on
# that line makes linux try to run "node\r" which does not exist. cost someone an
# afternoon once, not doing it again.
* text=auto eol=lf

*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf
